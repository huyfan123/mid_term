# Server Port
PORT=3000

# MongoDB Connection String (MongoDB Atlas)
# Note: include /QLHocPhan database name in the URI or in mongoose.connect
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/QLHocPhan?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/QLHocPhan?retryWrites=true&w=majority

# Cloudinary Credentials (get from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

