# ==========================================================
# FLUTTER FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================================
# Node.js Express REST API Base URL
#
# 1. For Flutter Web / Windows Desktop:
# API_BASE_URL=http://localhost:3000/api
#
# 2. For Android Emulator:
# (Note: The app automatically maps localhost to 10.0.2.2 on Android emulator,
# but you can also explicitly specify it here)
# API_BASE_URL=http://10.0.2.2:3000/api
#
# 3. For Real Android/iOS Phone over Wi-Fi (LAN):
# (Replace with your computer's local IP address, e.g. ipconfig on Windows)
# API_BASE_URL=http://192.168.1.100:3000/api

API_BASE_URL=http://localhost:3000/api
